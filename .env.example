# ApplyPilot AI - copy to backend/.env and adjust. Placeholders only; never commit real values.
APP_ENV=development            # development | production (production never mounts the mock employer)
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/applypilot.db

# AI provider. "mock" is deterministic, needs no key and labels everything DEMO.
# "openai_compatible" talks to any OpenAI-style /chat/completions endpoint (unverified without a real key).
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Browser automation (Playwright Chromium; install with `playwright install chromium`)
BROWSER_HEADLESS=true          # set false to watch the browser work
# The only site where forms are filled and submitted is this local mock employer.
MOCK_EMPLOYER_BASE_URL=http://127.0.0.1:8000/mock-employer
MOUNT_MOCK_EMPLOYER=true

# Serve the built UI (frontend/dist) from the backend so one command runs everything
SERVE_FRONTEND=true
