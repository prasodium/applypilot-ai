# ApplyPilot AI - copy to backend/.env and adjust. Placeholders only; never commit real values.
APP_ENV=development            # development | production
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/applypilot.db

# AI provider. "mock" is deterministic and needs no key; its output is labelled DEMO.
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

FRONTEND_ORIGIN=http://localhost:5173
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# Browser automation
BROWSER_HEADLESS=true          # set false to watch the browser
MOCK_EMPLOYER_PORT=8765
